{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shovels Addresses Meta API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Meta",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Data Release Date",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.shovels.ai/v2/meta/release-date"
          },
          "docs": "Returns the date of the current data release."
        },
        {
          "info": {
            "name": "Get Usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.shovels.ai/v2/usage"
          },
          "docs": "Get current credit usage for the rolling 30-day period."
        }
      ]
    }
  ],
  "bundled": true
}