          "name": "Search Permits",
          "request": {
            "name": "Search Permits",
            "description": {
              "content": "Returns a list of matching permit records based on geographic location and date range filters. Supports advanced filtering by permit status, tags, job value, property type, building area, and more.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "permits",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "geo_id",
                  "value": "<string>",
                  "description": "(Required) Location filter (address, city, zip code, county, jurisdiction, or state geo_id)"
                },
                {
                  "disabled": false,
                  "key": "permit_from",
                  "value": "<date>",
                  "description": "(Required) Return permits issued on or after this date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "permit_to",
                  "value": "<date>",
                  "description": "(Required) Return permits issued on or before this date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter by permit status (issued, approved, completed, expired, cancelled)"
                },
                {
                  "disabled": false,
                  "key": "tags",
                  "value": "<string>",
                  "description": "Filter by permit tags (comma-separated list)"
                },
                {
                  "disabled": false,
                  "key": "min_job_value",
                  "value": "<number>",
                  "description": "Minimum job value in dollars"
                },
                {
                  "disabled": false,
                  "key": "max_job_value",
                  "value": "<number>",
                  "description": "Maximum job value in dollars"
                },
                {
                  "disabled": false,
                  "key": "property_type",
                  "value": "<string>",
                  "description": "Filter by property type (residential, commercial, industrial)"
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Pagination cursor for next page"
                },
                {
                  "disabled": false,
                  "key": "size",
                  "value": "50",
                  "description": "Number of results per page (1-100, default 50)"
                },
                {
                  "disabled": false,
                  "key": "include_count",
                  "value": "<boolean>",
                  "description": "Include total count in response (capped at 10,000)"
                }
              ],
              "variable": []
            },
